--- /dev/null
+++ b/src/components/home/photos.ts
@@ -0,0 +1,25 @@
+import type { PublicCatalog } from '@/server/queries/public'
+
+export interface HomePhoto {
+  src: string
+  alt: string
+}
+
+/**
+ * Photos for the home page come from the catalogue the owner manages (featured
+ * courses first, then the other courses and the categories), so the page never
+ * hardcodes image names. Duplicates are dropped; the list may be empty.
+ */
+export function catalogPhotos(catalog: PublicCatalog): HomePhoto[] {
+  const seen = new Set<string>()
+  const out: HomePhoto[] = []
+  const push = (src: string | null, alt: string) => {
+    if (!src || seen.has(src)) return
+    seen.add(src)
+    out.push({ src, alt })
+  }
+  const services = [...catalog.services].sort((a, b) => Number(b.isFeatured) - Number(a.isFeatured))
+  for (const s of services) push(s.imageUrl, s.imageAlt ?? s.name)
+  for (const c of catalog.categories) push(c.imageUrl, c.name)
+  return out
+}
