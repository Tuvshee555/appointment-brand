+/** An amount in tögrög, tolerant of the thousands separator and not part of a bigger number. */
+const m = (n: number): string => `(?<![\\d,.])${Math.floor(n / 1000)}[,.\\s]?${String(n % 1000).padStart(3, '0')}(?![\\d])`
+/** A phone number as typed or grouped 4+4. */
+const ph = (p: string): string => `${p.slice(0, 4)}\\s?${p.slice(4)}`
+
+const REF = '\\b[A-Z]{2,4}-[A-Z0-9]{4,8}\\b'
