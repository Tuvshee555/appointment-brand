# Copy to .env.local for local development. Never commit real values.

# PostgreSQL (Neon or any Postgres 14+). Salon tables live in the `salon` schema.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Long random strings (>= 32 chars). SESSION_SECRET signs sessions and hashes IPs.
SESSION_SECRET=""
# Bearer token Vercel Cron sends to /api/cron/maintenance.
CRON_SECRET=""

# Public portfolio demo: demo admin access, daily demo reset, payment simulation,
# notifications only logged. Set to false for a real salon deployment.
DEMO_MODE=true

# Owner account created by `npm run db:seed` (full access — keep private).
ADMIN_EMAIL=owner@suvd.example
ADMIN_PASSWORD=""
ADMIN_NAME="Сувд - эзэмшигч"

# Absolute site origin for payment callbacks (optional; Vercel URL is used otherwise).
NEXT_PUBLIC_SITE_URL=""
# Ursgal Digital portfolio page the salon links back to.
NEXT_PUBLIC_PORTFOLIO_URL="https://ursgal-digital.vercel.app/#demos"
# Origins allowed to post Server Actions through the Ursgal multi-zone rewrite.
ALLOWED_ORIGINS="ursgal-digital.vercel.app"

# ---- Payments (QPay merchant v2) ----
# mock = labelled simulation (default, required for the public demo);
# sandbox = QPay test environment; production is refused while DEMO_MODE=true.
QPAY_MODE=mock
QPAY_BASE_URL=""
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
QPAY_CALLBACK_SECRET=""

# ---- Images (Cloudinary) — admin photo uploads ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- AI assistant (optional) ----
# Without a key the assistant runs its rule-based engine on the same data.
# AI_PROVIDER=anthropic | openai | gateway
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_GATEWAY_API_KEY=""
AI_MODEL=""
AI_DAILY_BUDGET_USD=2

# ---- Staff notifications (optional) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---- Facebook Messenger (optional, prepared but inactive until configured) ----
MESSENGER_VERIFY_TOKEN=""
MESSENGER_APP_SECRET=""
MESSENGER_PAGE_TOKEN=""
